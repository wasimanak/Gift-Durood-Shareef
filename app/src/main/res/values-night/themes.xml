<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Enforce Day/Light Mode even if system is in Night mode -->
    <style name="Base.Theme.DuroodCounter" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/islamic_green_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/islamic_mint_light</item>
        <item name="colorOnPrimaryContainer">@color/islamic_green_dark</item>
        <item name="colorSecondary">@color/islamic_gold</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/islamic_green_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.DuroodCounter" parent="Base.Theme.DuroodCounter" />
</resources>